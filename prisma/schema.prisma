datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  iin          String?
  roleId       String
  role         Role      @relation(fields: [roleId], references: [id])
  isSuspended  Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  software                Software[]
  applications            Application[]
  licenses                License[]
  notifications           Notification[]
  activityLogs            ActivityLog[]
  comments                Comment[]
  statusChanges           ApplicationStatusHistory[]
  performedEvents         LicenseEvent[]
  certificates            Certificate[]
  organizationMemberships OrganizationMember[]
}

model Role {
  id          String   @id @default(cuid())
  code        String   @unique // USER, ADMIN, REVIEWER, LICENSE_MANAGER
  name        String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]
}

model Permission {
  id          String   @id @default(cuid())
  code        String   @unique
  description String?

  roles       RolePermission[]
}

model RolePermission {
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
}

model Software {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  name        String
  version     String
  developer   String
  description String
  softwareType String  // Desktop, Web, Mobile, Enterprise, API
  platform    String   // Windows, macOS, Linux, Cross-platform, Cloud
  releaseDate DateTime
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  applications Application[]
  licenses     License[]
}

model Application {
  id                 String   @id // e.g. LIC-2026-000101
  userId             String
  user               User     @relation(fields: [userId], references: [id])
  softwareId         String
  software           Software @relation(fields: [softwareId], references: [id])
  
  status             String   // DRAFT, DOCUMENTS_REQUIRED, SIGNED, SUBMITTED, UNDER_REVIEW, ADDITIONAL_INFO_REQUIRED, APPROVED, REJECTED, LICENSE_ISSUED, CANCELLED
  licenseType        String   // Commercial, Educational, Personal, Enterprise
  licenseDuration    String   // 1 Year, 2 Years, 5 Years, Perpetual
  numUsers           Int      @default(1)
  category           String   // Commercial, Educational, Personal
  licenseDescription String?
  
  // Applicant details (Physical vs Legal entity)
  applicantType      String   @default("INDIVIDUAL") // INDIVIDUAL, LEGAL_ENTITY
  orgName            String?
  orgBin             String?
  orgAddress         String?
  representativeName String?
  representativeRole String?
  representativeBasis String?
  
  rejectionReason    String?
  requestedInfo      String?
  reviewDeadline     DateTime?
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  documents          ApplicationDocument[]
  digitalSignature   DigitalSignature?
  statusHistory      ApplicationStatusHistory[]
  license            License?
  comments           Comment[]
}

model ApplicationStatusHistory {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    String
  toStatus      String
  changedById   String
  changedBy     User        @relation(fields: [changedById], references: [id])
  comment       String?
  createdAt     DateTime    @default(now())
}

model ApplicationDocument {
  id             String      @id @default(cuid())
  applicationId  String
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  filename       String
  originalName   String
  mimeType       String
  sizeBytes      Int
  checksumSha256 String
  fileUrl        String
  uploadedAt     DateTime    @default(now())
}

model DigitalSignature {
  id                String      @id @default(cuid())
  applicationId     String      @unique
  application       Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  payloadHash       String      // SHA-256 canonical hash of payload + docs
  signature         String      // Cryptographic signature string
  algorithm         String      @default("GOST R 34.10-2015")
  signatureType     String      @default("NCALAYER") // NCALAYER, SIMULATED
  keyFingerprint    String      // Public key fingerprint
  verificationId    String      @unique // Public verification token
  signerName        String
  signerEmail       String
  signerIin         String?
  signerBin         String?
  certificateIssuer String?
  certificateSerial String?
  signedContent     String?     // Canonical JSON snapshot
  isVerified        Boolean     @default(true)
  signedAt          DateTime    @default(now())
}

model License {
  id                String   @id // e.g. CERT-8F92-41A0
  applicationId     String   @unique
  application       Application @relation(fields: [applicationId], references: [id])
  softwareId        String
  software          Software @relation(fields: [softwareId], references: [id])
  userId            String
  user              User     @relation(fields: [userId], references: [id])
  
  licenseType       String
  licenseKey        String   @unique
  issuedAt          DateTime @default(now())
  expiresAt         DateTime
  status            String   // ACTIVE, EXPIRING_SOON, EXPIRED, SUSPENDED, REVOKED
  qrCodeVerificationUrl String
  
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  events            LicenseEvent[]
}

model LicenseEvent {
  id          String   @id @default(cuid())
  licenseId   String
  license     License  @relation(fields: [licenseId], references: [id], onDelete: Cascade)
  eventType   String   // ISSUED, SUSPENDED, REINSTATED, EXTENDED, REVOKED
  performedById String
  performedBy User     @relation(fields: [performedById], references: [id])
  reason      String?
  createdAt   DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String   // APPLICATION_SUBMITTED, APPLICATION_APPROVED, APPLICATION_REJECTED, INFO_REQUESTED, LICENSE_ISSUED, EXPIRATION_WARNING
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ActivityLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userEmail String?
  action    String
  entity    String
  entityId  String?
  details   String?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())
}

model Comment {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  authorId      String
  author        User        @relation(fields: [authorId], references: [id])
  content       String
  isInternal    Boolean     @default(false)
  createdAt     DateTime    @default(now())
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String
  message   String
  status    String   @default("NEW") // NEW, READ, RESPONDED
  createdAt DateTime @default(now())
}

model SystemSetting {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String
  description String?
  updatedAt   DateTime @updatedAt
}

model Certificate {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectType      String    @default("INDIVIDUAL") // INDIVIDUAL, LEGAL_ENTITY
  ownerName        String
  iin              String?
  bin              String?
  organizationName String?
  keyFingerprint   String    @unique
  serialNumber     String?
  algorithm        String    // GOST_2015, RSA_2048
  issuer           String    // НУЦ РК (НИТ)
  source           String    @default("NCALAYER") // NCALAYER
  status           String    @default("ACTIVE") // ACTIVE, EXPIRED, REVOKED
  issuedAt         DateTime  @default(now())
  expiresAt        DateTime
  publicKeyPem     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
}

model Organization {
  id           String               @id @default(cuid())
  bin          String               @unique
  name         String
  legalAddress String?
  verified     Boolean              @default(false)
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  members      OrganizationMember[]
}

model OrganizationMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       // HEAD, REPRESENTATIVE, EMPLOYEE
  powerBasis     String?      // Устав, Доверенность №...
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, userId])
}

